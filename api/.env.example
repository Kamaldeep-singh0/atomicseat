# Atomic Seat API Environment Variables
PORT=4000
NODE_ENV=development

# MongoDB connection URI (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/atomicseat

# Redis connection URL (Upstash or local)
REDIS_URL=redis://localhost:6379

# JWT Secret
JWT_SECRET=atomic_seat_super_secret_jwt_key_2026

# Concurrency locking strategy: "naive" | "mongo-atomic" | "redis-lock"
LOCK_STRATEGY=mongo-atomic

# Lock duration in milliseconds (default 5 minutes = 300000ms)
LOCK_DURATION_MS=300000

# Rush simulator safety limit
MAX_RUSH_USERS=300

# Serverless instance identifier (auto-generated if omitted)
INSTANCE_ID=
