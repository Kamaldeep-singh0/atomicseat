# ===================================================
# Atomic Seat — Environment Configuration Example
# Branding: "Every seat. Exactly once."
# ===================================================

# Server Port
PORT=4000
NODE_ENV=production

# MongoDB Connection String (Atlas URI or local)
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/atomicseat?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/atomicseat

# Redis URL (Upstash TLS or local)
# Example Upstash: rediss://default:<password>@us1-active-panda-12345.upstash.io:6379
REDIS_URL=redis://localhost:6379

# JWT Authentication Secret
JWT_SECRET=atomic_seat_change_this_to_a_secure_random_string_2026

# Concurrency Locking Strategy: "naive" | "mongo-atomic" | "redis-lock"
LOCK_STRATEGY=mongo-atomic

# Lock duration in milliseconds (default: 5 minutes = 300000ms)
LOCK_DURATION_MS=300000

# Rush Worker Traffic Limits
MAX_RUSH_USERS=300
DEFAULT_DURATION_SECONDS=30

# Web Public Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Rush Worker URL (for API proxy routing)
WORKER_URL=http://localhost:5000
